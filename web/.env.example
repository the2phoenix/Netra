# NETRA Tactical Intelligence API Keys & Credentials
# Copy this file to .env and insert your personal API keys.
# All listed APIs have generous recurring free tiers / credits.

# 1. Google Maps Photorealistic 3D Tiles API Key ($200/month recurring GCP credit)
# Enable "Map Tiles API" in Google Cloud Console
VITE_GOOGLE_MAPS_KEY=AIzaSyAZu8mjUqiOqEaeNWVILfp2Tyd1vLkcexQ

# 2. Mapbox Access Token (50,000 free map loads/month)
# Get free token at https://account.mapbox.com/
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# 3. Windy Webcams API Key (1,000 free requests/day)
# Get free key at https://api.windy.com/
VITE_WINDY_KEY=your_windy_webcams_key_here

# 4. OpenSky Network ADS-B Credentials (OAuth2 Client Credentials)
# Register at https://opensky-network.org/
VITE_OPENSKY_CLIENT_ID=your_client_id_here
VITE_OPENSKY_CLIENT_SECRET=your_client_secret_here
